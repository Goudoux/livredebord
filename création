}">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1a1209;
    --parchment: #f5eed8;
    --parchment2: #ede4c8;
    --parchment3: #e4d9b8;
    --sepia: #8b6914;
    --sepia2: #c49a28;
    --ocean: #1b4f72;
    --ocean2: #2e86ab;
    --ocean3: #5ba4c7;
    --rust: #8b2e0f;
    --rust2: #c44a20;
    --muted: #7a6535;
    --border: #c4a84a;
    --border2: #8b6914;
    --radius: 4px;
    --shadow: 0 4px 24px rgba(26,18,9,0.18), 0 1px 4px rgba(26,18,9,0.12);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--parchment2);
    color: var(--ink);
    font-family: 'Crimson Pro', Georgia, serif;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
  }

  /* Nautical chart background grid */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(139,105,20,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139,105,20,0.08) 1px, transparent 1px),
      linear-gradient(rgba(139,105,20,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139,105,20,0.04) 1px, transparent 1px);
    background-size: 80px 80px, 80px 80px, 16px 16px, 16px 16px;
    pointer-events: none;
    z-index: 0;
  }

  /* Vignette edges */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(139,105,20,0.15) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .app {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 0 100px;
  }

  /* ─── HEADER ─── */
  header {
    background: var(--ocean);
    background-image:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 20px,
        rgba(255,255,255,0.02) 20px,
        rgba(255,255,255,0.02) 21px
      );
    border-bottom: 3px solid var(--sepia2);
    padding: 20px 24px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(26,18,9,0.4);
  }

  header::before {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--sepia), transparent);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-emblem {
    width: 44px; height: 44px;
    border: 2px solid var(--sepia2);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    background: rgba(255,255,255,0.06);
    position: relative;
    flex-shrink: 0;
  }

  .logo-emblem::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(196,154,40,0.3);
    border-radius: 50%;
  }

  .logo-text {
    font-family: 'Cinzel', serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--parchment);
    line-height: 1;
    text-transform: uppercase;
  }

  .logo-sub {
    font-family: 'Crimson Pro', serif;
    font-size: 11px;
    font-style: italic;
    color: var(--sepia2);
    letter-spacing: 2px;
    margin-top: 3px;
  }

  .header-stats {
    text-align: right;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: rgba(245,238,216,0.5);
    line-height: 1.7;
  }

  .header-stats .stat-val {
    color: var(--sepia2);
    font-weight: 700;
    font-size: 12px;
  }

  /* ─── INSTALL BUTTON ─── */
  .btn-install {
    display: none;
    align-items: center;
    gap: 6px;
    background: var(--sepia2);
    color: var(--ink);
    border: none;
    border-radius: var(--radius);
    padding: 8px 12px;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 1.5px;
    cursor: pointer;
    text-transform: uppercase;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(196,154,40,0.4);
    transition: all 0.2s;
    margin-top: 6px;
  }
  .btn-install:hover {
    background: var(--parchment);
    transform: translateY(-1px);
  }

  /* ─── TABS ─── */
  .tabs {
    display: flex;
    background: var(--parchment3);
    border-bottom: 2px solid var(--border);
    position: sticky;
    top: 84px;
    z-index: 99;
  }

  .tab {
    flex: 1;
    padding: 13px 8px 11px;
    text-align: center;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    transition: all 0.25s;
    text-transform: uppercase;
    position: relative;
  }

  .tab::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 20%;
    right: 20%;
    height: 3px;
    background: var(--ocean);
    transform: scaleX(0);
    transition: transform 0.25s;
  }

  .tab.active {
    color: var(--ocean);
    border-bottom-color: var(--ocean);
  }

  .tab.active::after { transform: scaleX(1); }

  .tab-icon { display: block; font-size: 16px; margin-bottom: 3px; }

  /* ─── SECTIONS ─── */
  .section { display: none; padding: 20px 16px; }
  .section.active { display: block; }

  /* ─── SOURCE BUTTONS ─── */
  .source-btns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 12px;
  }

  .btn-source {
    background: var(--parchment);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px 6px;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--ocean);
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    text-transform: uppercase;
    box-shadow: 0 1px 4px rgba(26,18,9,0.08);
  }

  .btn-source:hover {
    background: var(--ocean);
    color: var(--parchment);
    border-color: var(--ocean);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(27,79,114,0.25);
  }

  .paste-tip {
    background: rgba(196,154,40,0.08);
    border: 1px solid rgba(196,154,40,0.3);
    border-left: 3px solid var(--sepia2);
    border-radius: var(--radius);
    padding: 10px 14px;
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 14px;
    line-height: 1.5;
  }

  /* Pulse animation on paste zone */
  .paste-pulse {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    border: 2px solid var(--ocean2);
    opacity: 0;
    animation: pulseBorder 2.5s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes pulseBorder {
    0%, 100% { opacity: 0; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(1.01); }
  }

  /* ─── PHOTO ZONE ─── */
  .photo-zone {
    background: var(--parchment);
    border: 2px dashed var(--border);
    border-radius: 8px;
    padding: 28px 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
    margin-bottom: 16px;
    box-shadow: inset 0 2px 8px rgba(26,18,9,0.06);
  }

  .photo-zone:hover, .photo-zone.drag {
    border-color: var(--ocean2);
    background: #eef5fa;
  }

  .photo-zone input {
    position: absolute; inset: 0; opacity: 0; cursor: pointer;
  }

  /* Corner decorations */
  .photo-zone::before, .photo-zone::after {
    content: '';
    position: absolute;
    width: 20px; height: 20px;
    border-color: var(--sepia);
    border-style: solid;
  }

  .photo-zone::before {
    top: 8px; left: 8px;
    border-width: 2px 0 0 2px;
  }

  .photo-zone::after {
    bottom: 8px; right: 8px;
    border-width: 0 2px 2px 0;
  }

  .photo-zone-icon { font-size: 32px; margin-bottom: 8px; opacity: 0.7; }

  .photo-zone-title {
    font-family: 'Cinzel', serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--ocean);
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .photo-zone-sub {
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--muted);
  }

  .photo-preview {
    width: 100%;
    max-height: 200px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 12px;
    display: none;
    border: 1px solid var(--border);
  }

  /* ─── BUTTONS ─── */
  .btn-analyze {
    width: 100%;
    background: var(--ocean);
    color: var(--parchment);
    border: 2px solid var(--ocean2);
    border-radius: var(--radius);
    padding: 13px;
    font-family: 'Cinzel', serif;
    font-size: 12px;
    letter-spacing: 3px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.2s;
    margin-bottom: 16px;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(27,79,114,0.3);
  }

  .btn-analyze:hover {
    background: var(--ocean2);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(27,79,114,0.4);
  }

  .btn-analyze:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

  .btn-submit {
    width: 100%;
    background: var(--ink);
    color: var(--parchment);
    border: 2px solid var(--sepia2);
    border-radius: var(--radius);
    padding: 16px;
    font-family: 'Cinzel', serif;
    font-size: 15px;
    letter-spacing: 4px;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 8px;
    text-transform: uppercase;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }

  .btn-submit::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(196,154,40,0.1) 100%);
  }

  .btn-submit:hover {
    background: var(--ocean);
    border-color: var(--ocean3);
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(26,18,9,0.3);
  }

  /* ─── SPINNER ─── */
  .spinner {
    width: 15px; height: 15px;
    border: 2px solid rgba(245,238,216,0.3);
    border-top-color: var(--parchment);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    display: none;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* ─── AI STATUS ─── */
  .ai-status {
    background: rgba(27,79,114,0.07);
    border: 1px solid rgba(27,79,114,0.2);
    border-left: 3px solid var(--ocean2);
    border-radius: var(--radius);
    padding: 10px 14px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: var(--ocean);
    margin-bottom: 16px;
    display: none;
    letter-spacing: 0.5px;
  }

  /* ─── FORM SECTIONS ─── */
  .form-section {
    background: var(--parchment);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 14px;
    box-shadow: var(--shadow);
    position: relative;
  }

  /* Top rule decoration */
  .form-section::before {
    content: '';
    position: absolute;
    top: 0; left: 24px; right: 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .form-section-title {
    font-family: 'Cinzel', serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.5px;
    color: var(--ocean);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-transform: uppercase;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .badge-auto {
    font-family: 'Space Mono', monospace;
    font-size: 8px;
    background: rgba(27,79,114,0.1);
    color: var(--ocean);
    border: 1px solid rgba(27,79,114,0.25);
    padding: 2px 7px;
    border-radius: 2px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .badge-manual {
    font-family: 'Space Mono', monospace;
    font-size: 8px;
    background: rgba(139,46,15,0.08);
    color: var(--rust2);
    border: 1px solid rgba(139,46,15,0.2);
    padding: 2px 7px;
    border-radius: 2px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-grid.single { grid-template-columns: 1fr; }

  .field { display: flex; flex-direction: column; gap: 5px; }

  label {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
  }

  input, select, textarea {
    background: var(--parchment2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 9px 12px;
    color: var(--ink);
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    transition: all 0.2s;
    width: 100%;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--ocean2);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(27,79,114,0.08);
  }

  input.ai-filled {
    border-color: var(--ocean2);
    background: rgba(27,79,114,0.04);
    color: var(--ocean);
  }

  textarea { resize: vertical; min-height: 70px; font-family: 'Crimson Pro', serif; font-size: 14px; }

  select option { background: var(--parchment); color: var(--ink); }

  /* ─── LOG ─── */
  .log-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--border);
  }

  .log-title {
    font-family: 'Cinzel', serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--ocean);
  }

  .log-subtitle {
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
    letter-spacing: 1px;
  }

  .btn-export {
    background: var(--parchment);
    border: 1px solid var(--border2);
    color: var(--ocean);
    border-radius: var(--radius);
    padding: 8px 14px;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }

  .btn-export:hover { background: var(--ocean); color: var(--parchment); border-color: var(--ocean); }

  .log-empty {
    text-align: center;
    padding: 56px 20px;
    color: var(--muted);
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: 16px;
    opacity: 0.7;
  }

  .log-empty div { font-size: 48px; margin-bottom: 16px; opacity: 0.5; }

  /* ─── LOG ENTRY CARD ─── */
  .log-entry {
    background: var(--parchment);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 12px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow);
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Left accent stripe */
  .log-entry::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, var(--ocean2), var(--ocean));
    border-radius: 8px 0 0 8px;
  }

  /* Watermark compass rose */
  .log-entry::after {
    content: '✦';
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 64px;
    color: rgba(139,105,20,0.04);
    pointer-events: none;
    line-height: 1;
  }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
    padding-left: 8px;
  }

  .entry-datetime {
    font-family: 'Cinzel', serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--ocean);
  }

  .entry-id {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    color: var(--muted);
    margin-top: 3px;
    letter-spacing: 0.5px;
  }

  .btn-delete {
    background: none;
    border: 1px solid transparent;
    color: var(--muted);
    cursor: pointer;
    padding: 4px 8px;
    font-size: 14px;
    transition: all 0.2s;
    border-radius: var(--radius);
    line-height: 1;
    opacity: 0.5;
  }

  .btn-delete:hover { color: var(--rust2); border-color: var(--rust2); opacity: 1; }

  .entry-coords {
    background: rgba(27,79,114,0.06);
    border: 1px solid rgba(27,79,114,0.15);
    border-radius: var(--radius);
    padding: 6px 10px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: var(--ocean);
    margin: 0 0 10px 8px;
    display: flex;
    gap: 20px;
  }

  .entry-data {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 7px;
    margin-bottom: 10px;
    padding-left: 8px;
  }

  .data-item {
    background: var(--parchment2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 7px 10px;
    text-align: center;
  }

  .data-label {
    font-family: 'Cinzel', serif;
    font-size: 8px;
    color: var(--muted);
    letter-spacing: 2px;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .data-value {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    color: var(--ink);
    font-weight: 700;
  }

  .data-value.highlight { color: var(--ocean2); }

  .entry-remarks {
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: 14px;
    color: var(--muted);
    border-top: 1px solid var(--border);
    padding: 10px 0 0 8px;
    margin-top: 4px;
    line-height: 1.5;
  }

  /* ─── EXPORT SECTION ─── */
  .export-card {
    background: var(--parchment);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }

  .export-card-title {
    font-family: 'Cinzel', serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--ocean);
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    text-transform: uppercase;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px dashed rgba(139,105,20,0.2);
    font-family: 'Crimson Pro', serif;
    font-size: 14px;
  }

